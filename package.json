{
    "name": "fusion-dtl",
    "version": "1.0.0",
    "private": true,
    "type": "commonjs",
    "description": "SDK y validación operativa para FusionDTL",
    "scripts": {
        "test": "npm run test:node",
        "test:node": "node scripts/run-node-tests.cjs",
        "test:rust": "cargo test --all-targets --locked",
        "test:all": "npm run test:rust && npm run test:node",
        "build": "cargo build --all-targets --locked",
        "check": "cargo fmt --all -- --check && npm run check:js && cargo clippy --all-targets --all-features --locked -- -D warnings",
        "check:js": "node scripts/check-js.cjs",
        "ci": "npm run check && npm run build && npm run fmt:check && npm run test:all && npm run audit:runtime && npm run verify:release",
        "audit:runtime": "npm audit --omit=dev --audit-level=high",
        "ci:script": "bash scripts/ci.sh",
        "tests:script": "bash scripts/tests.sh",
        "fmt": "prettier --write --config .prettierrc --ignore-path .prettierignore \"**/*.{js,cjs,json,md,yml}\"",
        "fmt:check": "prettier --check --config .prettierrc --ignore-path .prettierignore \"**/*.{js,cjs,json,md,yml}\"",
        "verify:release": "node scripts/verify-release.cjs"
    },
    "keywords": [
        "dtl",
        "rust",
        "node-test",
        "settlement",
        "ledger"
    ],
    "devDependencies": {
        "prettier": "^3.9.5"
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
    }
}
